{
  "manifest_version": 3,
  "name": "Open in Refactor Diff",
  "version": "0.1.0",
  "description": "Adds an \"Open in Refactor Diff\" button to GitHub pull request and compare pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["github-url.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
