<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the generated Info.plist by Tauri. Declaring folders as a document type
       lets a repository be opened by dropping it on the Dock icon or with `open -a`; the
       refactor-diff:// URL scheme is how the browser extension opens a pull request or a
       branch comparison (`refactor-diff://open?repo=OWNER/NAME&pr=N`, see deep_link.rs). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.stevenbayer.refactor-diff</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>refactor-diff</string>
      </array>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Folder</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
