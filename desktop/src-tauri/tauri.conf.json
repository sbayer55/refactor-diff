{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Refactor Diff",
  "version": "0.1.0",
  "identifier": "com.stevenbayer.refactor-diff",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Review refactor-heavy diffs",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
